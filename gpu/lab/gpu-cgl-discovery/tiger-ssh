#!/bin/sh
set -eu
: "${OSX360_TIGER_HOST:?Set OSX360_TIGER_HOST to user@host or an SSH alias}"
exec ssh -T -o BatchMode=yes -o ConnectTimeout=5 -o ServerAliveInterval=5 -o ServerAliveCountMax=2 \
    -o HostKeyAlgorithms=+ssh-rsa -o PubkeyAcceptedAlgorithms=+ssh-rsa \
    -o StrictHostKeyChecking=yes "$OSX360_TIGER_HOST" "$@"
